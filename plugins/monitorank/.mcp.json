{
  "mcpServers": {
    "monitorank": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/index.js"
      ],
      "env": {
        "MONITORANK_API_KEY": "${MONITORANK_API_KEY:-}",
        "MONITORANK_JOURNAL_FILE": "${MONITORANK_JOURNAL_FILE:-}",
        "MONITORANK_JOURNAL_IN_PROJECT": "${MONITORANK_JOURNAL_IN_PROJECT:-}",
        "MONITORANK_DEFAULT_SITE": "${MONITORANK_DEFAULT_SITE:-}"
      }
    }
  }
}
